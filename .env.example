# Brickset API key — get one at https://brickset.com/tools/webservices/requestkey
# Optional bootstrap/fallback value: once an admin saves a key from the UI at
# /admin/brickset, the database value takes precedence over this one.
# Username/password are optional; they're only needed for owned/wanted collection
# sync features, which this app doesn't currently use.
BRICKSET_API_KEY=your-api-key-here

# Flask configuration
# Set to "1" only for local development. NEVER enable in production.
FLASK_DEBUG=0
# Used to sign session cookies and CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required outside of FLASK_DEBUG=1 — the app refuses to start without it.
SECRET_KEY=change-me-to-a-random-value

# Set to "1" once this app is deployed behind HTTPS (e.g. a reverse proxy
# terminating TLS). This marks the session cookie Secure, so browsers will
# refuse to send it over plain HTTP — leave at "0" only for local/LAN-only
# HTTP testing.
SESSION_COOKIE_SECURE=0

# Defaults to "1" since this app is expected to always run behind a reverse
# proxy that terminates TLS and sets X-Forwarded-Proto/Host/Port. This makes
# the app trust those headers so generated absolute URLs (notably the OIDC
# redirect_uri) use the proxy's public https://domain instead of the internal
# gunicorn bind address. Without this, OIDC logins behind a proxy typically
# fail with a "redirect_uri mismatch" error from the provider.
# Set to "0" only if clients ever reach gunicorn directly, with no proxy in
# front (trusting these headers from an untrusted client would let them spoof
# their own scheme/host).
TRUST_PROXY_HEADERS=1

# Path to the SQLite database file
DATABASE_PATH=lego_sets.db
SETS_DIR=sets
# Maximum accepted upload and downloaded remote asset size, in bytes (25 MiB).
MAX_CONTENT_LENGTH=26214400
MAX_DOWNLOAD_BYTES=26214400

# Optional: public base URL of this deployment (no trailing slash), e.g.
# https://lego.example.com. Used to build the absolute set-detail link
# encoded in each storage-box label's QR code. If left unset, storage-box
# label generation is skipped entirely (see the Labels section of the
# Utility page for a warning if this affects you).
#APP_BASE_URL=https://lego.example.com

# Authentication is managed at runtime, not via env vars:
# - Local accounts and roles are created/edited from the UI at /admin/users
#   (the very first run redirects you to /setup to create the initial admin).
# - OIDC/SSO (e.g. Authentik) is also configured from the UI at /admin/sso:
#   issuer URL, client ID/secret, scopes, and default role for new SSO users.
